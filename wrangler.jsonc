{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vistiq-recovery-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vistiq-recovery-preview"
    }
  ],
  "vars": {
    "R2_ACCOUNT_ID": "42dad13cae28bec30c33a1d52e1cfa5c",
    "R2_BUCKET_NAME": "vistiq-media",
    "CLOUDFLARE_ZONE_ID": "00490c1af532b05c9470f2926466cd97",
    "R2_PUBLIC_URL": "https://media.vistiqinvitation.com"
  },
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
